            for _hop in range(max_tool_hops):
                response = self.client.chat(
                    model=model,
                    messages=messages,
                    tools=[t for t in ALL_TOOLS if t.__name__ in self.kids_allowed_tools],
                    options={
                        "temperature": 0.3,
                        "num_predict": 300,
                        "num_gpu": 99,
                        "num_ctx": 2048,
                    },
                )
                msg = response["message"]
                messages.append(msg)
                tool_calls = msg.get("tool_calls")
                if not tool_calls:
