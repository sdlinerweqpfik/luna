<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Луна</title>
<style>
  html,body{height:100%;margin:0;background:#101418;font-family:monospace}
  #chat{height:calc(100% - 64px);overflow-y:auto;padding:8px;display:flex;flex-direction:column;gap:6px}
  .msg{max-width:80%;padding:8px 10px;border:1px solid #2a3a44;background:#1a2228;color:#cfe8f5;white-space:pre-wrap}
  .msg.me{align-self:flex-end;background:#12303a;border-color:#2a5a6a}
  .msg.sys{align-self:center;color:#7a8a94;border:none;background:none}
  #bar{height:64px;display:flex;gap:6px;padding:8px;box-sizing:border-box}
  #inp{flex:1;background:#1a2228;border:1px solid #2a3a44;color:#cfe8f5;padding:8px;font-size:16px}
  #send{background:#12303a;border:1px solid #2a5a6a;color:#cfe8f5;padding:8px 14px}
</style>
</head>
<body>
<div id="chat"></div>
<div id="bar">
  <input id="inp" autocomplete="off" placeholder="Сообщение Луне…">
  <button id="send">➤</button>
</div>
<script>
const chat=document.getElementById('chat'),inp=document.getElementById('inp');
let ws,token=localStorage.getItem('luna_token')||'';
if(!token){token=prompt('Токен Луны:')||'';localStorage.setItem('luna_token',token);}

function add(cls,text){
  const d=document.createElement('div');
  d.className='msg '+cls;
  d.textContent=text;
  chat.appendChild(d);
  chat.scrollTop=chat.scrollHeight;
}

function connect(){
  ws=new WebSocket('ws://'+location.hostname+':8765');
  ws.onopen=()=>ws.send(JSON.stringify({type:'auth',token}));
  ws.onmessage=e=>{
    const m=JSON.parse(e.data);
    if(m.type==='auth_ok'){
      add('sys','🌙 Луна на связи');
    } else if(m.type==='auth_fail'){
      add('sys','⛔ Неверный токен');
      localStorage.removeItem('luna_token');
      const newToken=prompt('Введите правильный токен Луны:')||'';
      if(newToken){
        token=newToken;
        localStorage.setItem('luna_token',token);
        add('sys',' Переподключение…');
        ws.close();
        setTimeout(connect,500);
      } else {
        add('sys','Токен не введён — соединение закрыто');
      }
    } else if(m.type==='reply'){
      add('luna',m.text);
    } else if(m.type==='pending'){
      add('sys','⚠ '+m.summary+' — ответь да/нет');
    }
  };
  ws.onclose=()=>{
    add('sys','связь потеряна, реконнект…');
    setTimeout(connect,3000);
  };
  ws.onerror=()=>{
    add('sys','ошибка соединения');
  };
}

function send(){
  const t=inp.value.trim();
  if(!t||!ws||ws.readyState!==1)return;
  add('me',t);
  ws.send(JSON.stringify({type:'text',text:t}));
  inp.value='';
  inp.focus();
}

document.getElementById('send').onclick=send;
inp.addEventListener('keydown',e=>{if(e.key==='Enter')send();});
connect();
</script>
</body>
</html>
</file>

